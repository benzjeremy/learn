{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Chapter",
  "type": "object",
  "required": ["id", "courseId", "chapterIndex", "title", "description", "sections"],
  "properties": {
    "id": { "type": "string" },
    "courseId": { "type": "string" },
    "chapterIndex": { "type": "integer", "minimum": 1 },
    "title": {
      "type": "object",
      "required": ["de", "en"],
      "properties": {
        "de": { "type": "string" },
        "en": { "type": "string" }
      }
    },
    "description": {
      "type": "object",
      "required": ["de", "en"],
      "properties": {
        "de": { "type": "string" },
        "en": { "type": "string" }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string", "enum": ["concept", "quiz_choice", "quiz_code_puzzle", "quiz_compiler_fix", "quiz_inline_code", "interactive_challenge"] },
          "title": {
            "type": "object",
            "properties": {
              "de": { "type": "string" },
              "en": { "type": "string" }
            }
          },
          "contentMarkdown": {
            "type": "object",
            "properties": {
              "de": { "type": "string" },
              "en": { "type": "string" }
            }
          },
          "codeSnippet": { "type": "string" },
          "buggyCode": { "type": "string" },
          "solutionCode": { "type": "string" },
          "compilerOutput": {
            "type": "object",
            "properties": {
              "de": { "type": "string" },
              "en": { "type": "string" }
            }
          },
          "slots": { "type": "object" },
          "prompt": {
            "type": "object",
            "properties": {
              "de": { "type": "string" },
              "en": { "type": "string" }
            }
          },
          "starterCode": { "type": "string" },
          "options": {
            "type": "array",
            "items": { "type": "string" }
          },
          "distractorExplanations": {
            "type": "object"
          },
          "solution": {
            "oneOf": [
              { "type": "string" },
              { "type": "integer" },
              { "type": "array", "items": { "type": "string" } },
              { "type": "object" }
            ]
          },
          "explanation": {
            "type": "object",
            "properties": {
              "de": { "type": "string" },
              "en": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
